# Copy this file to .env and adjust it. Every value has a working default.

# --- Database (Postgres with pgvector) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vector_db

# --- Embeddings (always local, through Ollama) ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Must match the vector size of EMBEDDING_MODEL (bge-m3: 1024, nomic-embed-text: 768).
# After changing the model, re-create the table: python -m rag_pipeline.ingest_books --reset
EMBEDDING_DIM=1024

# --- Answering model ---
# ollama = local model, openai or anthropic = hosted model.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# Thinking mode of local models: false is several times faster, true is the model default behaviour.
OLLAMA_THINK=false
# Context window in tokens for local models. Ollama's default of 4096 cuts off the rerank prompt.
OLLAMA_NUM_CTX=6144

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: another server that speaks the OpenAI API
OPENAI_BASE_URL=

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Folders ---
BOOKS_DIR=data/books
LOGS_DIR=logs
PROMPTS_DIR=config/prompts

# --- Chunking (sizes in characters) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Search ---
# hybrid = vector + keyword search, or use only one of them: vector, keyword
SEARCH_MODE=hybrid
# Weight of keyword search in the hybrid merge (vector search counts 1.0). 0.3 scored best in the evaluation.
KEYWORD_WEIGHT=0.3
# llm = let the answering model reorder the best candidates, none = keep the search order
RERANK_MODE=llm
# Chunks fetched by the search
RETRIEVAL_TOP_K=50
# Of those, how many the reranker looks at
RERANK_CANDIDATES=20
# How many chunks are given to the model as sources
RERANK_TOP_K=5

# --- Prompt ---
# File name without .txt in PROMPTS_DIR: default, citation_strict, minimal
PROMPT_TEMPLATE=default
CITATION_INSTRUCTION=Cite the sources you use with their numbers in square brackets, for example [1] or [2][3].

# --- Upload ---
MAX_UPLOAD_MB=50
